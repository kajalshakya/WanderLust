
<% /* Use the common boilerplate layout */ %>
<% layout("/layouts/boilerplate") %>


<!-- ==========================================
     Error Message Section
========================================== -->

<div class="row mt-3">

    <!-- Display error message in Bootstrap alert -->
    <div class="alert alert-danger col-6 offset-3" role="alert">

        <h4 class="alert-heading">
            <%= message %>
        </h4>

    </div>

</div>
