
<% /* Use the common boilerplate layout */ %>
<% layout("/layouts/boilerplate") %>


<!-- ==========================================
     Map Token and Listing Data
========================================== -->

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>


<!-- ==========================================
     Listing Details Section
========================================== -->

<div class="container mt-3">

    <!-- Listing Title -->
    <div class="row">

        <div class="col-12">
            <h3 class="listing-show-title">
                <b><%= listing.title %></b>
            </h3>
        </div>

    </div>


    <!-- Listing Information Card -->
    <div class="row">

        <div class="col-12 col-md-8 offset-md-2">

            <div class="card show-card">

                <!-- Listing Image -->
                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top show-img"
                    alt="listing_image"
                >

                <!-- Listing Information -->
                <div class="card-body">

                    <!-- Listing Owner -->
                    <p class="card-text owner-info">
                        Owned by <i><%= listing.owner.username %></i>
                    </p>

                    <!-- Listing Description -->
                    <p class="card-text description">
                        <%= listing.description %>
                    </p>

                    <!-- Listing Price -->
                    <p class="card-text">
                        &#8377;<%= listing.price.toLocaleString("en-IN") %>/Night
                    </p>

                    <!-- Listing Location -->
                    <p class="card-text">
                        <%= listing.location %>
                    </p>

                    <!-- Listing Country -->
                    <p class="card-text">
                        <%= listing.country %>
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- ==========================================
         Edit and Delete Listing Buttons
    ========================================== -->

    <% if(currUser && listing.owner._id.equals(currUser._id)) { %>

        <div class="row mt-3">

            <div class="col-12 col-md-8 offset-md-2">

                <div class="btns">

                    <!-- Edit Listing Button -->
                    <a
                        href="/listings/<%= listing._id %>/edit"
                        class="btn btn-dark edit-btn"
                    >
                        Edit
                    </a>


                    <!-- Delete Listing Form -->
                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>?_method=DELETE"
                    >

                        <button class="btn btn-dark">
                            Delete
                        </button>

                    </form>

                </div>

            </div>

        </div>

    <% } %>


    <!-- ==========================================
         Review Form Section
    ========================================== -->

    <% if(currUser) { %>

        <div class="row mt-4">

            <div class="col-12 col-md-8 offset-md-2">

                <hr>

                <h4>Leave a Review</h4>


                <!-- Review Submission Form -->
                <form
                    action="/listings/<%= listing._id %>/reviews"
                    method="POST"
                    novalidate
                    class="needs-validation"
                >

                    <!-- Star Rating Section -->
                    <div class="mb-3 mt-3 rating-container">

                        <label for="rating" class="form-label">
                            Rating
                        </label>

                        <fieldset class="starability-slot">

                            <!-- Default Rating -->
                            <input
                                type="radio"
                                id="no-rate"
                                class="input-no-rate"
                                name="review[rating]"
                                value="1"
                                checked
                                aria-label="No rating."
                            />


                            <!-- 1 Star -->
                            <input
                                type="radio"
                                id="first-rate1"
                                name="review[rating]"
                                value="1"
                            />

                            <label for="first-rate1" title="Terrible">
                                1 star
                            </label>


                            <!-- 2 Stars -->
                            <input
                                type="radio"
                                id="first-rate2"
                                name="review[rating]"
                                value="2"
                            />

                            <label for="first-rate2" title="Not good">
                                2 stars
                            </label>


                            <!-- 3 Stars -->
                            <input
                                type="radio"
                                id="first-rate3"
                                name="review[rating]"
                                value="3"
                            />

                            <label for="first-rate3" title="Average">
                                3 stars
                            </label>


                            <!-- 4 Stars -->
                            <input
                                type="radio"
                                id="first-rate4"
                                name="review[rating]"
                                value="4"
                            />

                            <label for="first-rate4" title="Very good">
                                4 stars
                            </label>


                            <!-- 5 Stars -->
                            <input
                                type="radio"
                                id="first-rate5"
                                name="review[rating]"
                                value="5"
                            />

                            <label for="first-rate5" title="Amazing">
                                5 stars
                            </label>

                        </fieldset>


                        <!-- Rating Instructions -->
                        <small class="rating-text">
                            Select your experience (1–5 stars)
                        </small>

                    </div>


                    <!-- Review Comment Section -->
                    <div class="mb-3 mt-3">

                        <label for="comment" class="form-label">
                            Comments
                        </label>

                        <textarea
                            name="review[comment]"
                            id="comment"
                            rows="5"
                            class="form-control"
                            required
                        ></textarea>

                        <!-- Validation Feedback -->
                        <div class="invalid-feedback">
                            Please add some comments for review.
                        </div>

                    </div>


                    <!-- Submit Review Button -->
                    <button class="btn btn-outline-dark">
                        Submit
                    </button>

                </form>

            </div>

        </div>

    <% } %>


    <!-- ==========================================
         All Reviews Section
    ========================================== -->

    <% if(listing.reviews.length > 0) { %>

        <div class="row mt-4">

            <div class="col-12 col-md-8 offset-md-2">

                <hr>

                <h4>All Reviews</h4>


                <!-- Reviews Container -->
                <div class="row review-row">

                    <!-- Loop Through All Reviews -->
                    <% for(let review of reviews) { %>

                        <div class="col-6 review-column">

                            <div class="card review-card">

                                <div class="card-body">

                                    <!-- Review Author -->
                                    <h5 class="card-title">
                                        @<%= review.author.username %>
                                    </h5>


                                    <!-- Review Star Rating -->
                                    <p
                                        class="starability-result card-text"
                                        data-rating="<%= review.rating %>"
                                    >
                                    </p>


                                    <!-- Review Comment -->
                                    <p class="card-text review-comment">
                                        <%= review.comment %>
                                    </p>

                                </div>


                                <!-- Delete Review Form -->
                                <form
                                    class="mb-3 ms-3"
                                    method="POST"
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                >

                                    <button class="btn btn-sm btn-dark">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    <% } %>

                </div>

            </div>

        </div>

    <% } %>


    <!-- ==========================================
         Listing Location Map Section
    ========================================== -->

    <div class="row mt-4">

        <div class="col-12 col-md-8 offset-md-2 mb-3">

            <!-- Map Heading -->
            <h3 class="where-heading">
                Where you'll be
            </h3>

            <!-- Map Container -->
            <div id="map"></div>

        </div>

    </div>

</div>


<!-- ==========================================
     External Map JavaScript
========================================== -->

<script src="/js/map.js"></script>
