
<% /* Use the common boilerplate layout */ %>
<% layout("/layouts/boilerplate") %>


<!-- ==========================================
     Create New Listing Page
========================================== -->

<div class="row mt-3">

    <div class="col-8 offset-2">

        <br>

        <!-- Page Heading -->
        <h3>Create a New Listing</h3>


        <!-- ==========================================
             New Listing Form
        ========================================== -->

        <form
            method="POST"
            action="/listings"
            novalidate
            class="needs-validation"
            enctype="multipart/form-data"
        >

            <!-- ==========================================
                 Listing Title
            ========================================== -->

            <div class="mb-3">
                <label for="title" class="form-label">Title</label>

                <input
                    name="listing[title]"
                    id="title"
                    placeholder="Add a catchy title"
                    type="text"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a valid title.
                </div>
            </div>


            <!-- ==========================================
                 Listing Description
            ========================================== -->

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>

                <textarea
                    name="listing[description]"
                    id="description"
                    class="form-control"
                    placeholder="Share details about your place..."
                    required
                ></textarea>

                <div class="invalid-feedback">
                    Please enter a description.
                </div>
            </div>


            <!-- ==========================================
                 Listing Image Upload
            ========================================== -->

            <div class="mb-3">
                <label for="image" class="form-label">Upload Listing Image</label>

                <input
                    name="listing[image][url]"
                    type="file"
                    class="form-control"
                    accept="image/*"
                >
            </div>


            <!-- ==========================================
                 Price and Country Fields
            ========================================== -->

            <div class="row">

                <!-- Listing Price -->
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>

                    <input
                        name="listing[price]"
                        id="price"
                        placeholder="₹ 1200"
                        type="number"
                        min="1"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid price.
                    </div>
                </div>


                <!-- Listing Country -->
                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>

                    <input
                        name="listing[country]"
                        id="country"
                        placeholder="India"
                        type="text"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid country.
                    </div>
                </div>

            </div>


            <!-- ==========================================
                 Listing Location
            ========================================== -->

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>

                <input
                    name="listing[location]"
                    id="location"
                    placeholder="Delhi, India"
                    type="text"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a valid location.
                </div>
            </div>


            <!-- ==========================================
                 Listing Category
            ========================================== -->

            <div class="mb-3">

                <label for="category" class="form-label">Category</label>

                <select
                    name="listing[category]"
                    id="category"
                    class="form-select"
                    required
                >
                    <option value="">Select Category</option>

                    <option value="Trending">Trending</option>
                    <option value="Rooms">Rooms</option>
                    <option value="Iconic cities">Iconic cities</option>
                    <option value="Mountains">Mountains</option>
                    <option value="Castles">Castles</option>
                    <option value="Amazing Pools">Amazing Pools</option>
                    <option value="Camping">Camping</option>
                    <option value="Farms">Farms</option>
                    <option value="Arctic">Arctic</option>
                    <option value="Waterfalls">Waterfalls</option>
                    <option value="Boats">Boats</option>

                </select>

                <div class="invalid-feedback">
                    Please select a category.
                </div>

            </div>


            <!-- ==========================================
                 Add Listing Button
            ========================================== -->

            <button class="btn btn-dark add-btn mt-3">
                Add
            </button>

        </form>

    </div>

</div>
