
<% /* Use the common boilerplate layout */ %>
<% layout("/layouts/boilerplate") %>


<!-- ==========================================
     Login Page
========================================== -->

<div class="row mt-3">

    <!-- Page Heading -->
    <h1 class="col-6 offset-3">Login</h1>

    <div class="col-6 offset-3">

        <!-- Login Form -->
        <form action="/login" method="POST" novalidate class="needs-validation">

            <!-- Username Field -->
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>

                <input
                    name="username"
                    id="username"
                    type="text"
                    class="form-control"
                    required
                >
            </div>


            <!-- Password Field -->
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>

                <input
                    name="password"
                    id="password"
                    type="password"
                    class="form-control"
                    required
                >
            </div>


            <!-- Login Button -->
            <button class="btn btn-success">Login</button>

        </form>

    </div>
</div>
